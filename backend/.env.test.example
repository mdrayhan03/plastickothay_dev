# ── TEST / CI ──────────────────────────────────────────────────────────────
# For the automated suite. Run with:  DJANGO_SETTINGS_MODULE=config.settings.test
# Unit tests need nothing (no DB). Integration + contract tests default to in-memory
# SQLite; set TEST_DATABASE_URL to a LOCAL Postgres for full-fidelity runs (the CI
# pipeline points this at a throwaway postgres:17 service container).

# --- Django ---
DJANGO_KEY=test-key
MODE=TEST

# --- Test database ---
# MODE=TEST never reads DATABASE_URL. The test settings default to in-memory SQLite; set
# TEST_DATABASE_URL to a LOCAL Postgres for full-fidelity runs. NEVER the prod pooler.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pk_test

# Email uses the in-memory backend and image storage uses local (both automatic in
# config.settings.test) - no credentials required.
