# Frontend build-time config (Vite). Copy to .env if you need to override a default.
# NOTE: VITE_* values are EMBEDDED IN THE BUNDLE at build time and are PUBLIC — never put
# secrets here. The frontend has no secrets; it only needs to know where the API is.

# --- API base URL --------------------------------------------------------------------------
# The app calls this. Default (unset) = '/api', a RELATIVE path — same-origin everywhere:
#   dev  -> Vite proxies /api to the backend (see VITE_BACKEND_URL below)
#   prod -> Django serves the built SPA, so /api is the same origin
# Only set a FULL URL if you deploy the SPA on a DIFFERENT origin than the API. That is a
# cross-origin setup and ALSO requires, on the backend: django-cors-headers + CORS_ALLOWED_
# ORIGINS, CSRF_TRUSTED_ORIGINS, and the refresh cookie switched to SameSite=None; Secure.
# VITE_API_URL=https://api.plastickothay.org/api

# --- Dev server port (dev only) ------------------------------------------------------------
# Port `npm run dev` (and the e2e runner) listen on. Default 5173. Bump it to dodge a conflict.
# VITE_PORT=5173

# --- Dev proxy target (dev only) -----------------------------------------------------------
# Where `npm run dev` forwards /api. Default http://localhost:8000. Change it if your Django
# dev server runs on another host/port (e.g. http://localhost:8001). Not used in prod builds.
# VITE_BACKEND_URL=http://localhost:8000
