# ── DEVELOPMENT ────────────────────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.dev.example .env
# Demo values below run the app fully offline: SQLite, console email, local file
# storage. No external accounts needed.
# DJANGO_SETTINGS_MODULE defaults to config.settings.dev (see manage.py).

# --- Django ---
DJANGO_KEY=dev-insecure-key-not-for-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave DATABASE_URL unset -> local SQLite (db.sqlite3). Uncomment to use a real Postgres.
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DB_POOLED=true

# --- Email --- (unset -> console backend prints emails to the terminal)
# Nothing needed for dev.

# --- Image storage --- (unset -> local filesystem under media/)
# Nothing needed for dev.
