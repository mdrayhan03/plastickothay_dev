# ── PRODUCTION ─────────────────────────────────────────────────────────────
# Real values belong in the host's secret store / GitHub Actions secrets - NOT in a
# committed file. This shows the shape with demo placeholders. Replace every value.
# Run with:  DJANGO_SETTINGS_MODULE=config.settings.prod

# --- Django ---
DJANGO_KEY=REPLACE-with-a-64-char-random-secret
DEBUG=false
ALLOWED_HOSTS=plastickothay.org,www.plastickothay.org

# --- Database (Supabase) ---
# MODE=PROD is REQUIRED here — it's the only mode that reads DATABASE_URL. (Without it the app
# falls back to SQLite, which is never what you want in production.)
MODE=PROD
# App runtime: transaction pooler (6543) + DB_POOLED=true.
# For migrations in CI/CD prefer the session pooler (5432) or direct connection.
DATABASE_URL=postgresql://postgres.xbxsvyvxpbiecmhyqzvu:REPLACE-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_POOLED=true

# --- Cross-origin frontend (separate host) ---
# Only needed when the SPA is served from a DIFFERENT origin than this API (e.g. a Render
# Static Site). List the exact frontend origin(s); never "*".
CORS_ALLOWED_ORIGINS=https://plastickothay-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://plastickothay-frontend.onrender.com,https://plastickothay-api.onrender.com
# Cross-origin => the refresh cookie must be SameSite=None (forces Secure), or the browser
# won't send it on the boot refresh call and users get logged out on every reload.
REFRESH_COOKIE_SAMESITE=None

# --- Email (Mailjet via Anymail) ---
EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@plastickothay.org
MAILJET_API_KEY=REPLACE-mailjet-api-key
MAILJET_SECRET_KEY=REPLACE-mailjet-secret-key

# --- Image storage (Google Drive) ---
# base64-encoded service-account JSON (single line). Switches storage from local to Drive.
GOOGLE_CREDENTIALS=REPLACE-base64-encoded-service-account-json
GOOGLE_DRIVE_FOLDER_ID=143-8VgTr2KPveoPtcJ4s2SZGrT1w8Vth
GOOGLE_DRIVE_TIMEOUT=30
