# Copy to .env and fill in. .env is gitignored - never commit real secrets.
# Absent values fall back to safe local defaults (SQLite, console email, local file storage),
# so the backend runs with an empty .env for development.

# --- Django ---------------------------------------------------------------
DJANGO_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Dev-server port for `python manage.py runserver` (no address arg). Default 8000.
# RUN_PORT=8000

# --- Database -------------------------------------------------------------
# MODE selects the database and is the only switch that matters:
#   DEV | TEST -> local SQLite. DATABASE_URL is IGNORED, so dev/test can never hit prod.
#   PROD       -> the Postgres URL below (required).
MODE=DEV
# Only used when MODE=PROD:
# DATABASE_URL=postgresql://user:pass@host:6543/postgres
# Set true when DATABASE_URL points at Supabase's TRANSACTION pooler (port 6543):
# it disables server-side cursors and prepared statements. Direct/session (5432) -> false.
DB_POOLED=false

# --- Email (Mailjet in prod; console backend in dev when unset) -----------
# EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.org
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=

# --- Image storage (Google Drive in prod; local filesystem when unset) ----
# Provide ONE of these to switch on Drive:
# GOOGLE_CREDENTIALS=<base64-encoded service-account JSON>
# GOOGLE_SERVICE_ACCOUNT_FILE=file.json
# GOOGLE_DRIVE_FOLDER_ID=143-8VgTr2KPveoPtcJ4s2SZGrT1w8Vth
# GOOGLE_DRIVE_TIMEOUT=30

# --- Tests ----------------------------------------------------------------
# Point at a LOCAL Postgres for full-fidelity integration/contract runs.
# Never the production pooler. Unset -> in-memory SQLite.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pk_test
